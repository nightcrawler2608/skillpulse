# Limited user for the public website (read + add feedback only). Don't type this one:
# run  python -m skillpulse.db.app_role  and it fills this line in for you.
APP_DATABASE_URL=

# --- Google AI Studio (Gemini LLM) â€” https://aistudio.google.com ---
GEMINI_API_KEY=

